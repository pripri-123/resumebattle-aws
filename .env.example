# -------------------------------------------------------------
# RESUME BATTLE 2.0 — ENVIRONMENT CONFIGURATION TEMPLATE
# -------------------------------------------------------------

# Flask Server Config
FLASK_ENV=development
FLASK_DEBUG=true
PORT=5000
HOST=0.0.0.0
SECRET_KEY=change-me-to-a-secure-random-string-in-production
JWT_SECRET_KEY=change-me-to-a-secure-random-string-in-production
JWT_EXPIRATION_HOURS=72

# Database Configuration (SQLite default for local dev; PostgreSQL for production/RDS)
DATABASE_URL=sqlite:///resume_battle.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/resume_battle_prod

# Storage Service Configuration ('local' for dev, 's3' for AWS production)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=storage_uploads
S3_BUCKET_NAME=your-production-resume-bucket-name
AWS_REGION=us-east-1

# AI Provider Configuration ('local' deterministic engine, 'bedrock' for AWS Bedrock)
AI_PROVIDER=local
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# Background Job Queue Backend ('local' worker pool, 'aws' for SQS/Lambda)
BACKGROUND_JOB_BACKEND=local

# Observability & CloudWatch
LOG_LEVEL=INFO
CLOUDWATCH_ENABLED=false

# Upload & File Limits
MAX_CONTENT_LENGTH=16777216
